# ===== محلي (على جهازك) =====
# PostgreSQL. أسهل طريقة: انسخ رابط قاعدة Railway العام (DATABASE_PUBLIC_URL)
# أو شغّل قاعدة محلية بالدوكر:
#   docker run -d --name nqel-db -e POSTGRES_PASSWORD=nqel -e POSTGRES_DB=nqel -p 5432:5432 postgres:16
DATABASE_URL="postgresql://postgres:nqel@localhost:5432/nqel"
AUTH_SECRET="غيّرها-لأي-نص-عشوائي-طويل"
# اختياري: بيانات حساب الإدارة عند أول تشغيل
# ADMIN_EMAIL="admin@nqel.com"
# ADMIN_PASSWORD="كلمة-مرور-قوية-8-أحرف-أو-أكثر"

# ===== على Railway (تضبطها من Variables) =====
# DATABASE_URL=${{Postgres.DATABASE_URL}}   (مرجع لخدمة PostgreSQL)
# AUTH_SECRET=<نص عشوائي طويل>
# ADMIN_EMAIL=...
# ADMIN_PASSWORD=...
# IGNORE_TS_ERRORS=1   (طوارئ فقط: لتجاوز أخطاء TypeScript مؤقتًا في البناء)
